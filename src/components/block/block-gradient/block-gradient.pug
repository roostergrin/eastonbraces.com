.block-gradient.invisection(
  :class="{ 'block-gradient--invis': $route.hash.includes('#invis') }")
  .block-gradients-image__col-title
    h1.block-gradients-image__title(v-html='content.title')
  .block-gradient-divi
    .block-gradient-image__col-body
      .block-gradient-image__col-text
        .block-gradient-image__body(v-html='content.body')
    .block-gradient-image__col-image
      .block-gradient-image__image-box
        .block-gradient-image
          .gradient-img
            img(v-bind:src='content.background' alt='')
  .block-gradient-newslider
    h4.block-gradient-newslidertitle Invisalign Before and After
    .invislidernew.common_slider
      swiper(:options='swiperOptioninvibeforeafter')
        swiper-slide(v-for='InviBeforeAfterSlider in content.invisalign_before_and_after_slider')
          .common_slideinvi
            img(v-bind:src='InviBeforeAfterSlider.img')
        .swiper-pagination(slot='pagination')   
        .swiper-button-prev(slot='button-prev')
          .fa.fa-angle-left
        .swiper-button-next(slot='button-next') 
          .fa.fa-angle-right     

  .aftergradient_info(v-html='content.afterinfo')          
  .block-gradient__schedules
    .over-box
    .block-gradient__content
      .block-gradient__col
        router-link(v-bind:to='content.schedule_btn_url' v-html='content.schedule_btn_text')
  .block-gradient-image__col-full
    .block-gradient-image__image-box
      .block-gradient-image.remove
        .gradient-img
          img(v-bind:src='content.img_2_url' alt='')
  .block-gradient-image__col-full
    .block-gradient-image__col-text
      .block-gradient-image__body(v-html='content.full_content')
