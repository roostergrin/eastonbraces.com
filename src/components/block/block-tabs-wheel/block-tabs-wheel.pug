.block-tabs-wheel
  .block-tabs-wheel__overlay
  .block-tabs-wheel__container-title
    .block-tabs-wheel__col-title
      h1.block-tabs-wheel__title(v-html='content.title')
  .block-tabs-wheel__container
    BaseIcon.block-tabs-wheel__background(:name='content.background')
    .block-tabs-wheel__tabs
      .block-tabs-wheel__tab(v-for='(title, i) in content.tabs'
        :key="'tab - ' + i"
        :class="{ 'block-tabs-wheel__tab--active': activeTab === i }"
        @mouseenter='setActive(i)'
        @click='setActive(i)')
        BaseIcon.block-tabs-wheel__tab-icon(:name='title.tab.icon')
        .block-tabs-wheel__tab-label(v-html='title.tab.label')
    
    .block-tabs-wheel__content
      .block-tabs-wheel__text-box(v-for='(content, i) in content.tabs'
        :key="'body - ' + i"
        :class="{ 'block-tabs-wheel__text-box--active': activeTab === i }")
        h1.block-tabs-wheel__section-title(v-html='content.tile.title' v-if='content.tile.title')
        .block-tabs-wheel__body(v-html='content.tile.body')
