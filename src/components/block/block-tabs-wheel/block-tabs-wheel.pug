.block-tabs-wheel
  .block-tabs-wheel__overlay
  .block-text-image__container
    .block-Investment-image__col-title
      h1.block-Investment-image__title(v-html='content.title')
    .block-main-Investment
      .block-Investment-image__col-image
        .block-Investment-image__image-box
          .block-Investment-image
            .Investment-img
              img(v-bind:src='content.image' alt='')
      .block-Investment-image__col-body
        .block-Investment-image__body.block-Investment-image__body--active(v-html='content.content')
  .block-text-image__container(v-for='(PatientTabss, i) in content.tab_list' :key="'PatientTabss - ' + i")
    .block-Included-image__col-title
      h2.block-Included-image__title.left-text(v-html='PatientTabss.title' @click='setActive(i)'
            :class="{ 'block-Included-image__title--active': activeAccord === i }")
    .block-Included-image__col-body
      .block-Investment-image__body(v-html='PatientTabss.content' :class="{ 'block-Investment-image__body--active': activeAccord === i }")