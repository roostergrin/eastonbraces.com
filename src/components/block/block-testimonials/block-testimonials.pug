.block-testimonials
  .block-testimonials__container
    .block-testimonials_wrap(:style="{ backgroundImage: 'url('+ content.bg_img +')'}")
      .block-testimonials_title
        h3(v-html='content.title')
      .custom-treatments_slider
        .common_slider.testislider
          swiper(:options='swiperOptiontestslider')
            swiper-slide(v-for='(slide, i) in content.slides')
              .testislide
                .testislide_body(v-html='slide.body')  
                .testislide_author(v-html='"- " + slide.author')            
            .swiper-button-prev(slot='button-prev')
              .fa.fa-chevron-left
            .swiper-button-next(slot='button-next') 
              .fa.fa-chevron-right       
