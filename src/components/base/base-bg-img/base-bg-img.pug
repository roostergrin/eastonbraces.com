.base-bg-img(
  role='img'
  :aria-label='alt'
  :style="{ backgroundImage: 'url(' + currentImg + ')' }"
  v-waypoint="{ active: true, callback: onWaypoint, options: intersectionOptions }")
  .base-bg-img__trigger(v-waypoint="{ active: true, callback: onWaypoint, options: intersectionOptions }")
  img(:alt='alt', style='visibility: hidden; height: 0;')
