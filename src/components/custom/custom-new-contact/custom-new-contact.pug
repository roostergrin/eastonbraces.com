.custom-new-contact
  .custom-new-contact__container
    .custom-new-contact__col-title
      h1.custom-new-contact__title(v-if='content.title' v-html='content.title')
  .custom-new-contact__container
    .custom-new-contact__col-info.customcolor
      h2.custom-new-contact__subtitle(v-html='content.subtitle')
      a.custom-new-contact__link(
        target='_blank'
        v-for='(link, i) in content.links'
        :key="'link - ' + i"
        :href='link.href'
        v-html='link.label')
    .custom-new-contact__col-form
      FormContact
