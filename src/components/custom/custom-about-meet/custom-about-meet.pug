.custom-about-meet
  BaseIcon.custom-about-meet__background.meet_svg(name='background-circle')
  .custom-about-meet__container
    .custom-about-meet__col-title
      h1.custom-about-meet__title(v-html='content.title')
      .doc_testimonial 
        p(v-html='content.meet_quote_text')
        .doc_testimonialname(v-html='content.meet_quote_author')
    .custom-about-meet__col-body
      .custom-about-meet__body(v-html='content.body')
    .custom-about-meet__col-slider    
      .common_slider.meet_slider
        swiper(:options='swiperOption1')
          swiper-slide(v-for='MeetSlider in content.slider')
            .common_slide(v-bind:style="{ backgroundImage: 'url('+ MeetSlider.image +')'}")
          .swiper-pagination(slot='pagination')   
          .swiper-button-prev(slot='button-prev')
            .fa.fa-angle-left
          .swiper-button-next(slot='button-next') 
            .fa.fa-angle-right
