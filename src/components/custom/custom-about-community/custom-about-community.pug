.custom-about-community
  h1.custom-about-community__title(v-html='content.title')
  .custom-about-community__container
    .custom-about-community__col
      .custom-about-community__slider
        .custom-about-community__prev(@click='slidePrev') <
        .custom-about-community__next(@click='slideNext') >
        BaseBGImg.custom-about-community__slide(
          v-for='(slide, i) in content.slides'
          :key="'slide - ' + i"
          :class="{ 'custom-about-community__slide--active': i === activeSlide }"
          :src='slide.image')
