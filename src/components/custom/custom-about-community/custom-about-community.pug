.custom-about-community
  h1.custom-about-community__title(v-html='content.title')
  .custom-about-community__container
    .custom-about-community__col
      .common_slider
        swiper(:options='swiperOption1')
          swiper-slide(v-for='officeTour in content.slides')
            .common_slide(v-bind:style="{ backgroundImage: 'url('+ officeTour.image +')'}")
          .swiper-pagination(slot='pagination')   
          .swiper-button-prev(slot='button-prev')
            .fa.fa-angle-left
          .swiper-button-next(slot='button-next') 
            .fa.fa-angle-right          
