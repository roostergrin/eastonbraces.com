.custom-home-retainer
  BaseLazyBg.custom-home-retainer__background(:src='content.image', :bgColor="'#eef5ff'" v-parallax='.1')
  .custom-home-retainer__container
    .custom-home-retainer__col
      h1.custom-home-retainer__title(v-html='content.title')
      h2.custom-home-retainer__title(v-html='content.subtitle')
      .custom-home-retainer__body(v-html='content.body')
