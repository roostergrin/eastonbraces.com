.pages-new-patients(v-if='props')
  BaseHero(:content='props.hero')
  transition-group(name='fade')
    BaseContainer(v-show='$route.hash === "#first" || $route.hash === ""' key='1')
      BlockTextImage(slot='first', :content='props.text_image')
    BaseContainer(v-show='$route.hash === "#investment"' key='2')
      BlockTabsWheel(slot='first', :content='props.patients_investment')
    BaseContainer(v-show='$route.hash === "#consultation"' key='3')
      CustomNewFree(slot='first', :content='props.free')
    BaseContainer(v-show='$route.hash === "#consultation"' key='4')
      CustomNewContact(slot='first', :content='props.contact')
