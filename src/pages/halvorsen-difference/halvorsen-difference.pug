.pages-halvorsen-difference(v-if='props')
  BaseHero(:content='props.hero')
  transition-group(name='fade')
  .block-text-image__container
    .block-main-apart#apart(key='1' v-for='TabDiff1 in props.wheel.tabs_new')
      .block-apart-image__col-title
        h1.block-apart-image__title(v-html='props.wheel.title') 
      .block-apart-image__col-image
        .block-apart-image__image-box
          .block-apart-image
            .apart-img
              .block-apart-image__body
                h3.block-apart-info-heading-small(v-html='TabDiff1.image_title') 
              img(v-bind:src='TabDiff1.image' alt='')
      .block-apart-image__col-body
        .block-apart-image__col-title
          h3.block-apart-info-heading(v-html='TabDiff1.title') 
        .block-apart-image__col-text
          .block-apart-image__body(v-html='TabDiff1.content') 
    .block-main-apart.reverse-apart#service-difference(key='2' v-for='TabDiff2 in props.wheel.tabs_new_2')
