.pages-halvorsen-difference(v-if='props')
  BaseHero(:content='props.hero')
  transition-group(name='fade')
    BaseContainer(v-show='$route.hash === "#apart" || $route.hash === ""' key='1')
      BlockTabsWheel(slot='first', :content='props.wheel')
    BaseContainer(v-show='$route.hash === "#reviews"' key='2')
      CustomDifferenceTestimonials(slot='first', :content='props.testimonials')
