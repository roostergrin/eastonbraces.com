.pages-treatments(v-if='props')
  BaseHero(:content='props.hero')
  transition-group(name='fade')
    BaseContainer(v-show='$route.hash === "#invisalign" || $route.hash === ""' key='1')
      BlockGradient(slot='first', :content='props.gradient')
    BaseContainer(v-show='$route.hash === "#braces"' key='2')
      CustomTreatmentsBraces(slot='first', :content='props.braces')
    BaseContainer(v-show='$route.hash === "#early"' key='3')
      CustomTreatmentsEarly(slot='first', :content='props.early')
    BaseContainer(v-show='$route.hash === "#adult"' key='4')
      BlockGradient(slot='first', :content='props.gradient_2')
    BaseContainer(v-show='$route.hash === "#life"' key='5')
      BlockGradient(slot='first', :content='props.gradient_3')
      CustomTreatmentsEmergencies(slot='second', :content='props.emergencies')
      CustomTreatmentsColor(slot='third', :content='props.color')
    BaseContainer(v-show='$route.hash === "#faq"' key='6')
      pre(slot='first') {{ props.faq }}
